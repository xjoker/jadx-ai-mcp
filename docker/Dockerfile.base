# JADX-AI-MCP Base Image
# Contains system dependencies that rarely change
# Build separately and push to Docker Hub
#
# Build: docker build -t xjoker/jadx-ai-mcp-base:1.1 -f docker/Dockerfile.base .
# Push:  docker push xjoker/jadx-ai-mcp-base:1.1

FROM eclipse-temurin:25-jre-noble

LABEL maintainer="xjoker"
LABEL description="Base image for JADX-AI-MCP with system dependencies"

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    VNC_PORT=5900 \
    NOVNC_PORT=6080 \
    TZ=UTC

# ============================================================================
# System dependencies (rarely changes - this is why we cache it)
# ============================================================================
# First update and upgrade existing packages to fix security vulnerabilities
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    # X11 and VNC
    xvfb \
    x11vnc \
    fluxbox \
    # Terminal + system monitor
    xterm \
    btop \
    # noVNC dependencies
    novnc \
    websockify \
    # Lightweight CJK font (instead of fonts-noto-cjk ~150MB)
    fonts-dejavu \
    fonts-liberation \
    fonts-wqy-zenhei \
    # Utilities
    wget \
    unzip \
    curl \
    supervisor \
    # Python for MCP Server
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Upgrade vulnerable Python packages installed by apt (Pillow CVE-2023-50447)
RUN PIP_BREAK_SYSTEM_PACKAGES=1 pip3 install --no-cache-dir --upgrade \
    "pillow>=10.2.0"

# Install uv package manager for running MCP Server (with retry for network reliability)
# Copy binary to /usr/local/bin instead of symlink to avoid permission issues with non-root user
RUN for i in 1 2 3 4 5; do \
        curl -LsSf https://astral.sh/uv/install.sh | sh && break || sleep 5; \
    done \
    && cp /root/.local/bin/uv /usr/local/bin/uv \
    && cp /root/.local/bin/uvx /usr/local/bin/uvx \
    && chmod +x /usr/local/bin/uv /usr/local/bin/uvx \
    && uv --version

# Create directories
WORKDIR /opt/jadx
RUN mkdir -p /apks /var/log/supervisor
