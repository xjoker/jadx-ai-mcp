# JADX-AI-MCP Base Image
# Contains system dependencies that rarely change
# Build separately and push to Docker Hub
#
# Build: docker build -t xjoker/jadx-ai-mcp-base:1.0 -f docker/Dockerfile.base .
# Push:  docker push xjoker/jadx-ai-mcp-base:1.0

FROM eclipse-temurin:21-jre-jammy

LABEL maintainer="xjoker"
LABEL description="Base image for JADX-AI-MCP with system dependencies"

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:99 \
    VNC_PORT=5900 \
    NOVNC_PORT=6080 \
    TZ=UTC

# ============================================================================
# System dependencies (rarely changes - this is why we cache it)
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # X11 and VNC
    xvfb \
    x11vnc \
    fluxbox \
    # Terminal + system monitor
    xterm \
    btop \
    # noVNC dependencies
    novnc \
    websockify \
    # Lightweight CJK font (instead of fonts-noto-cjk ~150MB)
    fonts-dejavu \
    fonts-liberation \
    fonts-wqy-zenhei \
    # Utilities
    wget \
    unzip \
    curl \
    supervisor \
    # Python for MCP Server
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install uv package manager for running MCP Server
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && ln -s /root/.local/bin/uv /usr/local/bin/uv \
    && ln -s /root/.local/bin/uvx /usr/local/bin/uvx

# Create directories
WORKDIR /opt/jadx
RUN mkdir -p /apks /var/log/supervisor
