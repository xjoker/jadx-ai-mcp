# JADX-AI-MCP Docker Image - Local Development Build
# Uses locally built plugin instead of downloading from GitHub
#
# Build: docker build -t jadx-ai-mcp-local -f docker/Dockerfile.local .
# Run:   docker run -d -p 6080:6080 -p 8651:8651 -v ./apks:/apks jadx-ai-mcp-local

# ============================================================================
# Use pre-built base image with system dependencies
# ============================================================================
ARG BASE_VERSION=1.0
FROM xjoker/jadx-ai-mcp-base:${BASE_VERSION}

LABEL maintainer="xjoker"
LABEL description="JADX-AI-MCP Local Dev Build with noVNC"

# Environment variables
ENV JADX_API_PORT=8650 \
    JADX_MCP_BIND_ADDRESS=0.0.0.0

# ============================================================================
# Layer 1: Download JADX
# ============================================================================
ARG JADX_VERSION=1.5.3
RUN wget -q "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/jadx-${JADX_VERSION}.zip" -O /tmp/jadx.zip \
    && unzip -q /tmp/jadx.zip -d /opt/jadx \
    && rm /tmp/jadx.zip \
    && chmod +x /opt/jadx/bin/*

# ============================================================================
# Layer 2: Install LOCAL plugin using JADX's official install command
# ============================================================================
ARG PLUGIN_JAR=target/jadx-ai-mcp-6.0.50.jar
COPY ${PLUGIN_JAR} /tmp/jadx-ai-mcp.jar

# Use JADX's official plugin installation command
RUN /opt/jadx/bin/jadx plugins --install-jar /tmp/jadx-ai-mcp.jar \
    && rm /tmp/jadx-ai-mcp.jar \
    && echo "Installed plugins:" && /opt/jadx/bin/jadx plugins --list

# ============================================================================
# Layer 3: MCP Server (local copy)
# ============================================================================
COPY jadx-mcp-server /opt/jadx/jadx-mcp-server
RUN cd /opt/jadx/jadx-mcp-server && uv sync --frozen

# ============================================================================
# Layer 4: Startup scripts
# ============================================================================
COPY docker/scripts/start.sh /start.sh
COPY docker/scripts/jadx-gui-wrapper.sh /opt/jadx/bin/jadx-gui-wrapper.sh
COPY docker/scripts/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
RUN chmod +x /start.sh /opt/jadx/bin/jadx-gui-wrapper.sh

# Expose ports
# 6080: noVNC web interface
# 8650: JADX Plugin HTTP API (internal)
# 8651: MCP Server HTTP endpoint (external, connect LLMs here)
EXPOSE 6080 8650 8651

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${JADX_API_PORT}/health || exit 1

# Start services
CMD ["/start.sh"]
