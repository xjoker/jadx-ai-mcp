# JADX-AI-MCP Docker Compose Environment Variables
#
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# Timezone (default: UTC)
# TZ=Asia/Shanghai

# APK directories for each JADX instance (default: ../temp)
# JADX1_APK_DIR=./apks/app1
# JADX2_APK_DIR=./apks/app2
# JADX3_APK_DIR=./apks/app3
